# ── Upvoted — local setup ──────────────────────────────────────────────
#  1. cp .env.example .env            (Prisma and the seed script read .env)
#  2. Start Postgres, e.g.:
#       docker run -d --name upvoted-pg -e POSTGRES_USER=upvoted \
#         -e POSTGRES_PASSWORD=upvoted -e POSTGRES_DB=upvoted -p 5432:5432 postgres:17-alpine
#  3. npm install
#  4. npx prisma migrate deploy
#  5. npm run db:seed                 (optional: fills the "Try demo" workspace)
#  6. npm run dev                     → http://localhost:3000, create an account at /signup
# ───────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://upvoted:upvoted@localhost:5432/upvoted"

# Auth
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""              # openssl rand -base64 32
AUTH_TRUST_HOST="true"

# Google sign-in (optional). Without it, email + password sign-up still works.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo: "true" shows the "Try demo" guest workspace (seed it with npm run db:seed)
DEMO_MODE="true"
CRON_SECRET=""              # openssl rand -base64 32 (protects /api/cron/reset-demo)

# Rate limiting (Upstash Redis) — optional in local dev, recommended in production
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
