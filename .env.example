# ── Upvoted demo — local setup ─────────────────────────────────────────
# This branch runs without a database: data lives in memory and is
# seeded with the demo workspace on startup.
#  1. cp .env.example .env.local
#  2. npm install
#  3. npm run dev                     → http://localhost:3000, click "Try demo"
# ───────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────

# Auth.js secret that signs the session JWT
AUTH_SECRET=""              # openssl rand -base64 32

# ── Optional ───────────────────────────────────────────────────────────

# Public base URL, used for metadata, the sitemap and robots.txt (netlify.toml sets it for the live demo)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in. Leave blank: accounts can't persist without a database, and
# the Google button then explains that it is not configured.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Rate limiting (Upstash Redis). Off when blank.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
