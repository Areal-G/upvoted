# ── Upvoted — local setup ──────────────────────────────────────────────
#  1. cp .env.example .env            (Prisma and the seed script read .env)
#  2. Start Postgres, e.g.:
#       docker run -d --name upvoted-pg -e POSTGRES_USER=upvoted \
#         -e POSTGRES_PASSWORD=upvoted -e POSTGRES_DB=upvoted -p 5432:5432 postgres:17-alpine
#  3. npm install
#  4. npx prisma migrate deploy
#  5. npm run seed                    (optional: sample board, sign in with SEED_OWNER_*)
#  6. npm run dev                     → http://localhost:3000, or create an account at /signup
# ───────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://upvoted:upvoted@localhost:5432/upvoted"

# Auth.js
AUTH_SECRET=""              # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"      # trust the host header behind a proxy

# Public base URL, used for metadata, the sitemap and robots.txt
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional ───────────────────────────────────────────────────────────

# Direct (non-pooled) connection for Prisma migrations when DATABASE_URL goes through a pooler
# DIRECT_URL=""

# Google sign-in. Without it, email + password sign-up still works.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Rate limiting (Upstash Redis) — off when blank, recommended in production
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sign-in for the sample board owner created by npm run seed.
# Blank uses the local-only defaults in prisma/seed/config.ts.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""

# End-to-end tests only (set in .env.test): enables the passwordless /e2e-login page
E2E_TEST_MODE=""

# Also read, but set by tooling rather than here: NODE_ENV (Next.js), and PORT and CI
# (Playwright; see .env.test.example and the CI workflow).
